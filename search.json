[
{% assign searchable = site.pages | where_exp: "p", "p.title" %}
{% assign emitted = 0 %}
{% for p in searchable %}{% unless p.search == false %}{% if emitted > 0 %},{% endif %}
  {"title":{{ p.title | jsonify }},"description":{{ p.description | default: '' | jsonify }},"url":{{ p.url | jsonify }},"section":{{ p.eyebrow | default: 'Docs' | jsonify }}}{% assign emitted = emitted | plus: 1 %}{% endunless %}{% endfor %}
]
